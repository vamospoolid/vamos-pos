        android:pathData="M37,81 A1.5,1.5 0 1,0 37,84 A1.5,1.5 0 1,0 37,81 Z"
        android:fillColor="#00E5FF" />
    <path
        android:pathData="M71,81 A1.5,1.5 0 1,0 71,84 A1.5,1.5 0 1,0 71,81 Z"
        android:fillColor="#00E5FF" />
</vector>

    <!-- Main Sharp Vamos 'V' Logo -->
    <path
        android:pathData="M30,26 L54,72 L78,26 L64,26 L54,46 L44,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"

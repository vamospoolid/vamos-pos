                android:endX="78"
                android:endY="72"
                android:type="linear"
                android:startColor="#00FF66"
                android:endColor="#00E5FF" />
        </aapt:attr>
    </path>

    <!-- Inner V Bevel Stroke -->
    <path
        android:pathData="M30,26 L54,72 L78,26 L64,26 L54,46 L44,26 Z"
        android:fillColor="#00000000"
        android:strokeColor="#AAFFFFFF"
        android:strokeWidth="0.6" />

